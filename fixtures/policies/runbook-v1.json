{
  "tenant_id": "synthetic-demo",
  "version": "runbook-v1",
  "name": "RetryPermit synthetic DLQ runbook v1",
  "auto_replay_cap": "500.00",
  "approved_currencies": ["USD"],
  "retry_limit": 3,
  "action_version": "schema-v3-to-v4-v1",
  "failure_signatures": [
