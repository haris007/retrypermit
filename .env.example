# Local demo mode is explicit and must never be presented as cloud deployment.
DEMO_MODE=true
USE_IN_MEMORY_STORE=true
USE_FAKE_MODEL=true
APP_ENV=local
LOG_LEVEL=INFO

# Required for local admin controls. Enter this value in the UI; it is not built in.
DEMO_ADMIN_TOKEN=replace-with-a-long-random-local-token

# Google Cloud / Gemini. Use ADC; never place service-account JSON in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GEMINI_MODEL=gemini-3.7-flash
CLOUD_RUN_REGION=us-central1

# Runtime resources.
PUBSUB_TOPIC=orders.dlq
PUBSUB_SUBSCRIPTION=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=retrypermit-processing
SERVICE_BASE_URL=
OIDC_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
CLOUD_TASKS_SERVICE_ACCOUNT=
RECOVERY_SERVICE_ACCOUNT=

# Bounded retry and dependency timeouts (seconds).
REPLAY_RETRY_BASE_SECONDS=1
REPLAY_RETRY_MAX_SECONDS=10
MODEL_TIMEOUT_SECONDS=20
DOWNSTREAM_TIMEOUT_SECONDS=10
POLICY_EXTRACTION_TIMEOUT_SECONDS=45
TRIAGE_CONCURRENCY=4

# Class B policy uses 300 seconds in production. The local hackathon demo exposes
# a short per-message task/recovery interval without changing production policy.
DEMO_RECHECK_SECONDS=10
SIMULATED_TRANSIENT_RECOVERY_SECONDS=10

# Local-only test bypass for push/task routes. Refused unless DEMO_MODE=true.
ALLOW_LOCAL_SERVICE_AUTH=false
